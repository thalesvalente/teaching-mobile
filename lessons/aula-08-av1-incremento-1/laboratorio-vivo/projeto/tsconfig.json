{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react-native": [
        "./node_modules/react-native"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ]
    },
    "types": [
      "react"
    ]
  },
  "include": [
    "App.tsx",
    "../shared/ProjetoUniversal.tsx"
  ]
}
